[Unit]
Description=arm-gateway (HTTP+JSON edge + static console on :2600)
After=arm-core.service
Wants=arm-core.service
StartLimitIntervalSec=0

[Service]
User=intern
ExecStart=/home/intern/arm-core/target/release/arm-gateway 0.0.0.0:2600 /tmp/arm-core.sock /home/intern/arm-web-dist
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
